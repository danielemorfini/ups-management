################################################################################
## UPS related settings
## - UPS_NAME (string) : UPS name defined in /etc/nut/ups.conf
## - UPSC_TIMEOUT (int) : Maximum seconds to wait for a single upsc query
################################################################################
UPS_NAME=ups-name@localhost
UPSC_TIMEOUT=10

################################################################################
## System settings
## - TARGET_EMAIL (string) : Proxmox user used for email notifications
## - MAIL_TIMEOUT (int) : Maximum seconds to wait for the mail command to send an email
################################################################################
TARGET_EMAIL=user
MAIL_TIMEOUT=15

################################################################################
## Management thresholds
## - MIN_CHARGE (int) : Start shutting down services below this percentage (e.g. 75%)
## - MIN_RUNTIME (int) : Start shutting down services below this amount of seconds (e.g. 2500 ~40m)
## - SHUTDOWN_THRESHOLD (int) : Trigger full host FSD (power off) at this percentage (e.g. 50%)
################################################################################
MIN_CHARGE=75
MIN_RUNTIME=2500
SHUTDOWN_THRESHOLD=50

################################################################################
## PBS settings
## - PBS_IP (string) : PBS server IP (ssh must be configured for passwordless login)
## - PBS_TIMEOUT (int) : Maximum seconds to wait for PBS to go offline
################################################################################
PBS_IP=10.0.0.10
PBS_TIMEOUT=120

################################################################################
## Guest settings
## - GUEST_SHUTDOWN_TIMEOUT (int) : Maximum seconds to wait per VM/LXC before forcing it to stop
## - SERVICE_CMD_TIMEOUT (int) : Maximum seconds to wait for any single qm/pct/ssh query
################################################################################
GUEST_SHUTDOWN_TIMEOUT=60
SERVICE_CMD_TIMEOUT=30

################################################################################
## Application settings
## - BASE_DIR (string) : Base directory for UPS management scripts
## - LOG_FILE (string) : Log file for UPS monitoring
## - POLL_INTERVAL (int) : Polling interval (in seconds) for checking UPS status
################################################################################
BASE_DIR=/opt/ups-management
LOG_FILE=/var/log/ups-monitor.log
POLL_INTERVAL=5
